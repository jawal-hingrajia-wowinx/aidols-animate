FAL_KEY=your_fal_api_key_here

# Postgres connection string (Vercel Postgres, Neon, Supabase, etc. all work)
DATABASE_URL=postgresql://user:password@host/dbname

# From the Vercel dashboard once a Blob store is created on the project
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Single shared login for the app. Both must be set or nobody can sign in.
AUTH_USERNAME=aidols
AUTH_PASSWORD=change_me

# Optional: signing key for the session cookie. Leave unset and it's derived
# from the credentials above, which is stable across serverless cold starts.
# Set it explicitly in production so you can rotate sessions independently.
SESSION_SECRET=
